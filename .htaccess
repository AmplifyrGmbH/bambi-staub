Options -Indexes
ErrorDocument 404 /404.html

# Clean URLs: /bambi → bambi.html
RewriteEngine On

# www → ohne www (sonst doppelter Inhalt unter zwei Adressen)
RewriteCond %{HTTP_HOST} ^www\.bambi-staub\.ch$ [NC]
RewriteRule ^(.*)$ https://bambi-staub.ch/$1 [R=301,L]

# Alte Adressen dauerhaft weiterleiten
RewriteRule ^lage/?$ /umgebung [R=301,L]
RewriteRule ^gaestebuch/?$ /bambi#gaestebuch [R=301,L,NE]

# Schrägstrich am Ende bei Seiten entfernen: /bambi/ → /bambi
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^((?:en/)?[a-z0-9_-]+)/$ /$1 [R=301,L]

# /en and /en/ → en/index.html (before directory check, en/ is a real dir)
RewriteRule ^en/?$ en/index.html [L,NC]

# /buchen and /buchen/ → buchen/index.html
RewriteRule ^buchen/?$ buchen/index.html [L,NC]

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Handle /en/page → en/page.html
RewriteRule ^en/([a-z0-9_-]+)/?$ en/$1.html [L,NC]

# Map /page → page.html
RewriteRule ^([a-z0-9_-]+)/?$ $1.html [L,NC]

# HTTPS leitet Hostpoint bereits selbst um (http → https, 301)

# Interne Dateien nicht ausliefern (Entwicklungsserver, Notizen, PHP-Konfiguration)
<FilesMatch "(^\.|\.(md|py|sh|ini|jsonl|rtf|log|bak)$|^(router|server)\.(php|py)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(config|cache|\.github)(/|$)

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  # HTML immer frisch prüfen, sonst sehen Besucher Änderungen bis zu 30 Tage nicht
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Kompression (Hostpoint komprimiert bereits; zur Sicherheit)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
